{
  "name": "rolldown-plugin-strip",
  "version": "0.1.0",
  "description": "Rolldown plugin to remove debug-only code paths.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run test",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "rolldown",
    "plugin",
    "strip"
  ],
  "author": "sam-parsons",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sam-parsons/rolldown-plugin-strip.git"
  },
  "bugs": {
    "url": "https://github.com/sam-parsons/rolldown-plugin-strip/issues"
  },
  "homepage": "https://github.com/sam-parsons/rolldown-plugin-strip#readme",
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/estree": "^1.0.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "magic-string": "^0.30.21"
  }
}
